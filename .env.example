# Server-only OpenAI key. Configure this in .env.local for local API development
# and as a Production secret in Vercel. Never prefix it with VITE_ or NEXT_PUBLIC_.
OPENAI_API_KEY=

# All AI endpoints use gpt-4o-mini. The model is fixed in server/openai-config.js.
# OpenAI keys and request data are never included in browser bundles or logs.
