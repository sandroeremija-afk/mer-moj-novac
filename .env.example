# Server-only assistant provider. Supported values: gemini, openwebui.
AI_PROVIDER=openwebui

# Open WebUI configuration. Use the instance root URL, an API key created by a
# dedicated least-privileged account, and an exact model id returned by /api/models.
# The instance must be reachable from the deployed Vercel Function.
OPEN_WEBUI_BASE_URL=https://webui.moj.eracun
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_MODEL=gemma4:26b

# Optional private-PKI rotation or alternate-host override. The current public
# self-signed leaf for the exact webui.moj.eracun host is pinned in server code:
# SHA-256 CE:A9:BC:1B:6F:4F:72:83:5F:5D:7F:4D:E1:23:63:31:22:66:7F:58:BA:9C:01:9B:FD:41:80:B2:69:7E:39:A6
# and expires on 2027-06-30 at 10:50:38Z. Before rotation, deploy BOTH renewed
# values together. OPEN_WEBUI_CA_CERT accepts a multiline PEM or a single-line
# value containing literal \n separators. Leave both empty for the bundled pin
# or when using a publicly trusted TLS certificate.
OPEN_WEBUI_CA_CERT=
OPEN_WEBUI_CERT_SHA256=

# Never set NODE_TLS_REJECT_UNAUTHORIZED=0. The server keeps normal certificate
# and hostname validation enabled, then additionally checks the exact leaf pin.

# Server-only Google Gemini configuration. Never expose either provider key in client code.
GEMINI_API_KEY=

# Optional server-only compatibility fallback when GEMINI_API_KEY is not set.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional server-only model override.
GEMINI_MODEL=gemini-3.7-flash
